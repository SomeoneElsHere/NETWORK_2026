{
  "version": "0.2.0",
  "configurations": [
    {
   
      "name": "(gdb) Attach",
      "type": "cppdbg",
      "request": "attach",
      "program": "enter program name, for example ${workspaceFolder}/a.out",
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "Enable pretty-printing for gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {
              "description": "Set Disassembly Flavor to Intel",
              "text": "-gdb-set disassembly-flavor intel",
              "ignoreFailures": true
          }
      ]
    },
    {
      "type": "cppdbg",
      "request": "launch",
      "name": "Peer",
      "program": "${workspaceFolder}/build/peer",
      "cwd": "${workspaceFolder}/build/"
    },
    {
      "type": "cppdbg",
      "request": "launch",
      "name": "Tracker",
      "program": "${workspaceFolder}/build/tracker",
      "cwd": "${workspaceFolder}/build/"
    }
  ],
  "compounds": [
        {
            "name": "1 Peer",
            "configurations": ["Tracker", "Peer"]
        }
    ]
}