libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libmd
Description: Message Digest functions from BSD systems
Version: 1.2.0
URL: https://www.hadrons.org/software/libmd/
Maintainer: <libbsd@lists.freedesktop.org>
